<block wx:if="{{loading}}">
  <view class="loading">
    加载中...
  </view>
</block>

<block wx:else>
  <view class="container">
    <view class="header-section">
      <view class="logo-text">🌱</view>
      <view class="main-title">一起成长</view>
      <view class="sub-title">每天一点点，成长看得见。</view>
    </view>

    <view class="action-section">
      <button class="btn-primary" hover-class="btn-hover" bindtap="goToCreate">创建活动</button>
      <button class="btn-secondary" hover-class="btn-hover" bindtap="goToJoin">加入活动</button>
    </view>

    <view class="activity-section">
      <view class="section-title">我的成长计划</view>

      <block wx:for="{{activities}}" wx:key="_id">
        <view class="activity-card" bindtap="goToActivity" data-id="{{item._id}}">
          <view class="activity-title">
              {{item.title}}
          </view>
          <view class="activity-description">
              {{item.description}}
          </view>

          <block wx:if="{{!item.isFinished}}">
            <view class="activity-days" >
                Day {{item.currentDay}} / {{item.days}}
            </view>

            <view class="progress">
              <view class="progress-bar"
                    style="width:{{item.completionRate}}%">
              </view>
            </view>
              <view class="activity-description progress-percent">
                {{item.completionRate}}%
              </view>
            
          </block>
          <block wx:else>
            <view class ="activity-description">
              🎉 已完成
            </view>
            <view class ="activity-description">
              🏆 打卡 {{item.checkedDays}} / {{item.days}} 天
            </view>
            <view class="activity-description">
              ⭐ 完成率 {{item.completionRate}}%
            </view>

          </block>
          
          <block wx:if="{{!item.isFinished}}">         

            <block wx:if="{{!item.hasCheckedToday}}">
              <view class = "activity-status">
                  ⭕ 今天尚未打卡
              </view>

              <view class="activity-status">
                  👉 去完成今天的成长
              </view>

            </block>
            <block wx:else>
              <view class = "activity-status">
                ✅ 已完成今日打卡
              </view>          
            </block>

            <block wx:if="{{item.streak>0}}">
                <view class="activity-status">
                    🔥 已连续坚持 {{item.streak}} 天
                </view>
            </block>

            <block wx:else>
                <view class="activity-status">
                    🌱 今天开始你的第一次坚持
                </view>
            </block>

          </block>

          <view class="activity-participants" wx:if="{{item.participantCount==1}}">
            👤 仅你自己          
          </view>
          <view class="activity-status" wx:else>
            👥 {{item.participantCount}} 人参加
          </view>
          <view class="activity-status activity-code">
            邀请码：{{item.joinCode}}
          </view>
        </view>
      </block>

      <view class="empty-state" wx:if="{{activities.length===0}}">
        <text class="empty-text">还没有参加活动。</text>
        <text class="empty-text">创建一个成长计划，</text>
        <text class="empty-text">邀请伙伴一起开始吧 🌱</text>
      </view>
    </view>
  </view>
</block>