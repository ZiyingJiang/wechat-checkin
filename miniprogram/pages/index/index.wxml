<view class="container">
  <view class="header-section">
    <text class="logo-text">🌱</text>
    <text class="main-title">一起成长</text>
    <text class="sub-title">每天一点点，成长看得见。</text>
  </view>

  <view class="action-section">
    <button class="btn-primary" hover-class="btn-hover" bindtap="goToCreate">创建活动</button>
    <button class="btn-secondary" hover-class="btn-hover" bindtap="goToJoin">加入活动</button>
  </view>

  <view class="activity-section">
    <view class="section-title">我的活动</view>

    <view class="empty-state">
      <text class="empty-text">还没有参加活动。</text>
      <text class="empty-text">创建一个成长计划，</text>
      <text class="empty-text">邀请伙伴一起开始吧 🌱</text>
    </view>
  </view>
</view>