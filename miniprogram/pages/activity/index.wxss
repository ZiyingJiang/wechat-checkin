
/* pages/index/index.wxss */

/* 页面背景 */

.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

/* Header */
.header-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.main-title {
  font-size:48rpx;
  font-weight:700;
  color:#222;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.sub-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #7D7D7D;
  margin-bottom: 16rpx;
}

/* 内容区域 */
.activity-section {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.section-title {
  font-size:34rpx;
  font-weight:600;
  color:#333;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.activity-code {
  font-size: 28rpx;
  color: #9A9A9A;
}

/* Card */
.card,
.time-card,
.activity-card,
.history-card,
.empty-card {
  background: #ffffff;
  border: 2rpx solid #eeeeee;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
}


.time-title,
.history-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.time-description {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 今日状态 */
.activity-title {
  font-size:32rpx;
  font-weight:600;
  color:#222;
  margin-bottom:12rpx;
}

.activity-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom:20rpx;
}

.activity-status {
  margin-top:16rpx;
  color:#555;
  line-height:1.6;
}

/* Button */
.submit-section {
  margin-top: 28rpx;
}

/* 按钮通用基础样式 */
.btn-primary, .btn-secondary {
  width: 100%;
  height: 88rpx; /* 按钮高度 48px -> 96rpx */
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx; /* 按钮文字 17px -> 34rpx */
  font-weight: 600;
  letter-spacing:2rpx;
  padding: 0;
  box-shadow: none ; /* 无阴影极简风格 */
}

/* 按钮点击反馈 */
.btn-hover {
  opacity:.85;
}

/* 主按钮：鼠尾草绿底白字 */
.btn-primary {
  background-color:#4caf50;
  color:white;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* History */
.history-item {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 30rpx;
  color: #666;
}

.history-item:last-child {
  border-bottom: none;
}

.history-day,
.history-value {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 16rpx;
}


/* 空状态 */
.history-empty {
  margin-top: 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* Progress Bar */
.progress {
  margin-top: 24rpx;
  margin-bottom:20rpx;
  width: 100%;
  height: 14rpx;
  background: #ececec;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #4caf50;
  border-radius: 10rpx;
}

.loading {
  padding:120rpx;
  color:#999;
  text-align:center;
}