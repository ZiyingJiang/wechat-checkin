
/* pages/index/index.wxss */

/* 页面背景 */

.container {
  min-height: 100vh;
  background: #F6F8F5;
  padding: 40rpx;
  box-sizing: border-box;
}

/* Header */

.header-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.sub-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #888;
}

/* 内容区域 */

.activity-section {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* Card */

.time-card,
.activity-card,
.history-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
}

/* Day */

.time-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.time-description {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 今日状态 */

.activity-title,
.history-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.activity-description {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #666;
}

/* Button */

.submit-section {
  margin-top: 28rpx;
}

.btn-primary {
  background: #7FAE7B;
  color: white;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn-primary::after {
  border: none;
}

/* History */

.history-item {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EFEFEF;
  font-size: 30rpx;
  color: #555;
}

.history-item:last-child {
  border-bottom: none;
}

/* 空状态 */

.history-empty {
  margin-top: 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* Progress Bar */

.progress {
  margin-top: 24rpx;
  width: 100%;
  height: 16rpx;
  background: #E8ECE7;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #7FAE7B;
  border-radius: 999rpx;
}