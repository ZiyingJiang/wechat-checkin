
/* pages/create/index.wxss */

/**
 * 基础页面样式
 * 采用东方极简风格，配合暖米白背景与充足的留白
 */
 .container {
    min-height: 100vh;
    max-width:750rpx;
    margin:0 auto;
    background-color: #f7f8fa;
    padding: 32rpx; /* 页面左右间距 24px -> 48rpx */
    padding-bottom:80rpx; /* 避免键盘弹起，按钮贴底 */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }
  
  /**
   * 顶部 Logo 与标语区
   * 留白充足，文字居中，营造宁静、治愈的氛围
   */
  .header-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 120rpx; /* 顶部预留呼吸空间 */
    padding-bottom: 80rpx;
  }
  
  .logo-text {
    font-size: 56rpx; /* 徽标作为视觉点缀 */
    margin-bottom: 32rpx;
  }
  
  .main-title,
  .success-title {
    font-size:48rpx;
    font-weight:700;
    color:#222;
    line-height: 1.4;
    margin-bottom: 16rpx;
  }
  
  .sub-title {
    max-width:520rpx;
    font-size: 28rpx; /* 说明文字 14px -> 28rpx */
    color: #7D7D7D; /* 次文字颜色 */
    line-height: 1.5;
    text-align: center;
  }
  
  /**
   * Form区
   * 
   */
  .form-section {
    display:flex;
    flex-direction:column;
    gap:48rpx;
  }

  .form-item{
    display:flex;
    flex-direction:column;
    gap:16rpx;
  }
   
  .form-label {
    font-size:32rpx;
    font-weight:600;
    color:#666;
  }
   
  .example-text{
    font-size:24rpx;
    color:#9A9A9A;
    line-height:1.6;
    margin-top:-4rpx;
    margin-bottom:8rpx;
  }
   
  .form-input {
    width:100%;
    height:88rpx;
    background:#f7f8fa;
    border:2rpx solid #eeeeee;
    border-radius:20rpx;
    padding:0 24rpx;
    box-sizing:border-box;
    font-size:30rpx;
    color:#3E3E3E;
  }
   
  .form-textarea{
    width:100%;
    min-height:180rpx;
    background:#f7f8fa;
    border:2rpx solid #eeeeee;
    border-radius:20rpx;
    padding:24rpx;
    box-sizing:border-box;
    font-size:30rpx;
    line-height:1.6;
    color:#666;
  }

  .metric-group{
    display:flex;
    flex-direction:column;
    gap:20rpx;
  }
   
  
  /**
 * 操作按钮区
 * 模块间距 24px -> 48rpx
 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 按钮之间的自然间距 */
  margin-bottom: 48rpx; /* 模块间距 24px -> 48rpx */
}
  
  
/* 按钮通用基础样式 */
.btn-primary, .btn-secondary {
  width: 100%;
  height: 88rpx; /* 按钮高度 48px -> 96rpx */
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx; /* 按钮文字 17px -> 34rpx */
  font-weight: 600;
  letter-spacing:2rpx;
  padding: 0;
  box-shadow: none ; /* 无阴影极简风格 */
}

/* 按钮点击反馈 */
.btn-hover{
  opacity:.85;
}

/* 主按钮：鼠尾草绿底白字 */
.btn-primary {
  background-color:#4caf50;
  color:white;
  border: none;
}

/* 副按钮：白底绿边绿字 */
.btn-secondary {
  background-color: #FFFFFF;
  color: #7FAE7B;
  border: 2rpx solid#4caf50;
  box-sizing: border-box;
}


  .tip-text {
    font-size: 24rpx;
    color: #9A9A9A;
    line-height: 1.6;
    text-align: center;
    margin-bottom: 32rpx;
  }

  .divider {
    width: 100%;
    height: 2rpx;
    background-color:#f7f8fa;
    margin: 48rpx 0;
  }

  /* success  */
/* Card */
.card,
.success-card,
.time-card,
.activity-card,
.history-card,
.empty-card {
  background: #ffffff;
  border: 2rpx solid #eeeeee;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
}

 .success-title {
    font-size:42rpx;
    font-weight:700;
    line-height: 1.6;
    margin-bottom:24rpx;
    text-align: center;
} 

.success-tip{
  font-size:28rpx;
  color:#7D7D7D;
  line-height:1.4;
  margin-bottom:40rpx;
  text-align: center;
}

.code-label{
  font-size:28rpx;
  color:#999;
  margin-bottom:12rpx;
  text-align: center;
}

.join-code{
  font-size:56rpx;
  font-weight:700;
  color: #4caf50;
  letter-spacing:8rpx;
  background:#F4FAF4;
  border-radius:18rpx;
  padding:26rpx 0;
  margin-bottom:48rpx;
  text-align: center;
  border:2rpx dashed #B7D8B5;
}

.success-buttons{
  display:flex;
  flex-direction:column;
  gap:20rpx;
}

.copy-btn{
  background:#5E9F62;
  color:white;
  border-radius:999rpx;
}

