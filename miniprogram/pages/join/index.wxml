<view class="container">

<view class="header-section">
  <view class="main-title">加入成长活动</view>
  <view class="sub-title">输入邀请码，</view>
  <view class="sub-title">与伙伴一起坚持成长。</view>
</view>

<view class="form-section">

  <view class="form-item">

    <view class="form-label">
      邀请码
    </view>

    <input
      class="form-input"
      placeholder="请输入6位邀请码"
      maxlength="6"
      auto-focus="true"
      confirm-type="done"
      bindinput="onCodeInput"
    />

  </view>

</view>

<view class="divider"></view>

<view class="action-section">

  <view class="tip-text">
    加入成功后即可开始每日打卡。
  </view>

  <button
    class="btn-primary"
    bindtap="handleJoinActivity"
    loading="{{submitting}}"
    disabled="{{submitting}}">
    {{submitting ? "加入中..." : "加入活动"}}
  </button>

</view>

</view>