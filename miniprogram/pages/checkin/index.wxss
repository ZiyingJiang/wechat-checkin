
/* pages/index/index.wxss */

/**
 * 基础页面样式
 * 采用东方极简风格，配合暖米白背景与充足的留白
 */
 .container {
  min-height: 100vh;
  max-width:750rpx;
  margin:0 auto;
  background-color: #F8F6F2;
  padding: 0 48rpx; /* 页面左右间距 24px -> 48rpx */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/**
 * 顶部 Logo 与标语区
 * 留白充足，文字居中，营造宁静、治愈的氛围
 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx; /* 顶部预留呼吸空间 */
  padding-bottom: 80rpx;
}

.logo-text {
  font-size: 56rpx; /* 徽标作为视觉点缀 */
  margin-bottom: 32rpx;
}

.main-title {
  font-size: 44rpx; /* 标题加粗  */
  font-weight: bold;
  color: #3E3E3E; /* 主文字颜色 */
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.sub-title {
  max-width:520rpx;
  font-size: 28rpx; /* 说明文字 14px -> 28rpx */
  color: #7D7D7D; /* 次文字颜色 */
  line-height: 1.5;
  text-align: center;
}

/**
 * 操作按钮区
 * 模块间距 24px -> 48rpx
 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 按钮之间的自然间距 */
  margin-bottom: 48rpx; /* 模块间距 24px -> 48rpx */
}

/* 按钮通用基础样式 */
.btn-primary, .btn-secondary {
  width: 100%;
  height: 96rpx; /* 按钮高度 48px -> 96rpx */
  line-height: 96rpx;
  border-radius: 24rpx; /* 圆角 16px -> 32rpx */
  font-size: 34rpx; /* 按钮文字 17px -> 34rpx */
  font-weight: 500;
  letter-spacing:2rpx;
  padding: 0;
  box-shadow: none ; /* 无阴影极简风格 */
}

/* 按钮点击反馈 */
.btn-hover{
  opacity:.85;
}

/* 主按钮：鼠尾草绿底白字 */
.btn-primary {
  background-color: #7FAE7B;
  color: #FFFFFF;
  border: none;
}

/* 副按钮：白底绿边绿字 */
.btn-secondary {
  background-color: #FFFFFF;
  color: #7FAE7B;
  border: 2rpx solid #7FAE7B;
  box-sizing: border-box;
}

/**
 * 我的活动区
 */
.activity-section {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.section-title {
  font-size: 34rpx; /* 分组标题 17px -> 34rpx */
  font-weight: bold;
  color: #3E3E3E; /* 主文字颜色 */
  margin-bottom: 24rpx;
}

/**
 * 空状态卡片
 * 白底、无阴影、细灰边、圆角20px
 */
.empty-state {
  min-height:220rpx;
  background-color: #FFFFFF; /* 卡片背景白色 */
  border: 2rpx solid #E9E6E1; /* 细灰边分隔线颜色 */
  border-radius: 32rpx; /* 卡片圆角 20px -> 40rpx */
  padding: 56rpx 40rpx; /* 卡片内边距 20px -> 40rpx，上下适当留白 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: none; /* 无阴影 */
}

.empty-text {
  font-size: 28rpx; /* 正文文字 */
  color: #7D7D7D; /* 次文字颜色 */
  line-height: 1.8;
  text-align: center;
  display: block;
}

.empty-text:last-child{
  margin-top:8rpx;  
}

/**
 * 卡片及内容
 * 
 */
.activity-item {
  background: #FFFFFF;
  border: 2rpx solid #E9E6E1;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.activity-card {
  background: #FFFFFF;
  border: 2rpx solid #E9E6E1;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.activity-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #3E3E3E;
  margin-bottom: 12rpx;
}

.activity-description {
  font-size: 28rpx;
  color: #7D7D7D;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.activity-days {
  font-size: 26rpx;
  color: #7FAE7B;
  margin-bottom: 12rpx;
}

.activity-code {
  font-size: 24rpx;
  color: #9A9A9A;
}

.activity-participants{
  margin-top:16rpx;
  font-size:26rpx;
  color:#666;
}
