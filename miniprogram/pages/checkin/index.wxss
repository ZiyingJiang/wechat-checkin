
/* pages/index/index.wxss */

/**
 * 基础页面样式
 * 采用东方极简风格，配合暖米白背景与充足的留白
 */
.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

/**
 * 顶部 Logo 与标语区
 * 留白充足，文字居中，营造宁静、治愈的氛围
 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx; /* 顶部预留呼吸空间*/ 
  padding-bottom: 32rpx;
}

.main-title {
  font-size:48rpx;
  font-weight:700;
  color:#222;
  line-height: 1.4;
}

.sub-title {
  max-width:520rpx;
  font-size: 30rpx; /* 说明文字 14px -> 28rpx */
  color: #7D7D7D; /* 次文字颜色 */
  line-height: 1.5;
  text-align: center;
  margin-top: 16rpx;
}

.activity-description {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
}


/**
 * 操作按钮区
 * 模块间距 24px -> 48rpx
 */
.metric-section,
.submit-section {
  margin-top:24rpx;
  margin-bottom:32rpx;
}
.note-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx; /* 模块间距 24px -> 48rpx */
}

/* 按钮通用基础样式 */
.btn-primary, .btn-secondary {
  width: 100%;
  height: 88rpx; /* 按钮高度 48px -> 96rpx */
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx; /* 按钮文字 17px -> 34rpx */
  font-weight: 600;
  letter-spacing:2rpx;
  padding: 0;
  box-shadow: none ; /* 无阴影极简风格 */
}

/* 按钮点击反馈 */
.btn-hover{
  opacity:.85;
}

/* 主按钮：鼠尾草绿底白字 */
.btn-primary {
  background-color: #4caf50;
  color: #FFFFFF;
  border: none;
}


.metric-group {
  margin-bottom:32rpx;
}

.metric-label {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #333;
}

.metric-input {
  border: 1px solid #eeeeee;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 30rpx;
  background: #f7f8fa;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  border: 1px solid #eeeeee;
  border-radius: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background:#f7f8fa;
}

.submit-section {
  margin-top: 40rpx;
}

.logo-text { 
  font-size: 28rpx; /* 徽标作为视觉点缀 */ 
  margin-bottom: 32rpx; 
  text-align: center; 
}

.loading{
  padding:120rpx;
  color:#999;
  text-align:center;
}